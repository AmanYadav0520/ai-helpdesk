DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk?schema=public"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"

# Used by prisma/seed.ts to bootstrap the first (admin) user, since sign-up is disabled
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"

# Shared secret the inbound-email webhook (POST /api/webhooks/inbound-email) checks
# against the x-webhook-secret header (or ?secret= query param)
WEBHOOK_SECRET="changeme"

# Used by POST /api/replies/polish (gpt-5-nano via the Vercel AI SDK) to polish agent reply drafts,
# and by the inbound-email webhook (POST /api/webhooks/inbound-email) to classify new tickets in the
# background after the ticket is created
OPENAI_API_KEY=""

# Used by the send-email background job (apps/server/src/lib/send-email.ts) to email customers —
# both a human agent's reply (POST /api/replies) and an AI auto-resolved reply trigger it
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="" # Verified sender address (e.g. support@yourdomain.com)

SENTRY_DSN="" # Optional: Sentry error tracking DSN
SENTRY_ENVIRONMENT="" # e.g. development, staging, production
